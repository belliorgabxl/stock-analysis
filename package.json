{
	"name": "stock-alert-worker",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"typecheck": "tsc --noEmit",
		"backtest": "esbuild scripts/backtest.ts --bundle --platform=node --format=esm --outfile=.wrangler/backtest.mjs --log-level=warning && node .wrangler/backtest.mjs",
		"news:dry": "esbuild scripts/news-dry.ts --bundle --platform=node --format=esm --outfile=.wrangler/news-dry.mjs --log-level=warning && node .wrangler/news-dry.mjs",
		"register-commands": "node scripts/register-commands.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"hono": "^4.11.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^25.2.2",
		"typescript": "^5.9.3",
		"wrangler": "^4.63.0"
	}
}
