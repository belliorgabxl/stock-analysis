	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"hono": "^4.11.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^25.2.2",
		"typescript": "^5.9.3",
		"wrangler": "^4.63.0"
	}
}
